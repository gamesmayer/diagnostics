<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RootNamespace>GamesMayer.Diagnostics</RootNamespace>
    <AssemblyName>GamesMayer.Diagnostics</AssemblyName>
    <PackageId>GamesMayer.Diagnostics</PackageId>
    <Version>0.2.1</Version>
    <Authors>GAMESMAYER</Authors>
    <Description>GAMESMAYER C# code diagnostics.</Description>
    <RepositoryUrl>https://github.com/gamesmayer/diagnostics</RepositoryUrl>
    <PackageProjectUrl>https://github.com/gamesmayer/diagnostics</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>gamesmayer-icon.png</PackageIcon>
    <PackageTags>roslyn;analyzers;diagnostics;codefix;csharp;unity;code-style</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoWarn>RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.3.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="4.3.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true"
          PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../assets/gamesmayer-icon.png" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
