[*.cs]

# Restore default severity for all rules to avoid unintended consequences of editorconfig inheritance
dotnet_analyzer_diagnostic.severity = default

# Disable formatting rules that conflict with GamesMayer.Diagnostics rules
dotnet_diagnostic.IDE0055.severity = none

# Encoding & whitespace
charset = utf-8-bom
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Braces
csharp_new_line_before_open_brace = all
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = true
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true
csharp_prefer_braces = true:warning

# Using directives
dotnet_diagnostic.IDE0005.severity = none  # Remove unnecessary using directives
dotnet_diagnostic.CS8019.severity = warning  # Unnecessary using directive (compiler warning)

# Unused variables
dotnet_diagnostic.CS0219.severity = none      # Unused variable (compiler warning)
dotnet_diagnostic.IDE0058.severity = none     # Expression value is never used
dotnet_diagnostic.IDE0059.severity = warning  # Unnecessary assignment of a value (unused vars)

# Namespaces
dotnet_diagnostic.IDE0130.severity = none     # Namespace does not match folder structure
csharp_style_namespace_declarations = block_scoped:warning

# var usage
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_when_type_is_apparent = false:warning
csharp_style_var_elsewhere = false:warning
dotnet_diagnostic.IDE0007.severity = warning   # Use explicit type instead of 'var' (when type is apparent)
dotnet_diagnostic.IDE0008.severity = warning   # Use explicit type instead of 'var' (elsewhere)

# Expression-bodied members
csharp_style_expression_bodied_methods = false:warning
csharp_style_expression_bodied_constructors = false:warning
csharp_style_expression_bodied_properties = true:warning
csharp_style_expression_bodied_accessors = true:warning
dotnet_diagnostic.IDE0021.severity = warning   # Use block body for constructors
dotnet_diagnostic.IDE0022.severity = warning   # Use block body for methods
dotnet_diagnostic.IDE0025.severity = none      # Use expression body for properties (disabled: false positives with #if blocks in Unity)
dotnet_diagnostic.IDE0027.severity = warning   # Use expression body for accessors

# Code style
dotnet_diagnostic.IDE0001.severity = warning  # Simplify name (e.g. System.Exception → Exception)
dotnet_diagnostic.IDE0002.severity = warning  # Simplify member access (e.g. MyClass.Member → Member inside the same class)
csharp_style_throw_expression = true:warning
csharp_style_implicit_object_creation_when_type_is_apparent = true:warning
dotnet_diagnostic.IDE0090.severity = warning  # Use 'new(...)' instead of 'new T(...)'
dotnet_diagnostic.IDE0041.severity = none     # Use 'is null' check instead of reference equality
dotnet_diagnostic.IDE0031.severity = warning  # Use null propagation (?.) instead of ternary null check
dotnet_diagnostic.IDE0029.severity = warning  # Use coalescing expression (??) where applicable
dotnet_diagnostic.IDE0270.severity = warning  # Null check can be simplified

# Naming conventions

## Private fields: _camelCase (underscore prefix required)
dotnet_naming_rule.private_fields_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_underscore_camel_case.style = underscore_camel_case_style
dotnet_naming_rule.private_fields_underscore_camel_case.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

## Protected fields: camelCase (no underscore prefix)
dotnet_naming_rule.protected_fields_camel_case.symbols = protected_fields
dotnet_naming_rule.protected_fields_camel_case.style = camel_case_style
dotnet_naming_rule.protected_fields_camel_case.severity = warning

dotnet_naming_symbols.protected_fields.applicable_kinds = field
dotnet_naming_symbols.protected_fields.applicable_accessibilities = protected

## Public members: PascalCase
dotnet_naming_rule.public_members_pascal_case.symbols = public_members
dotnet_naming_rule.public_members_pascal_case.style = pascal_case_style
dotnet_naming_rule.public_members_pascal_case.severity = warning

dotnet_naming_symbols.public_members.applicable_kinds = property, method, event, class, struct, enum, namespace
dotnet_naming_symbols.public_members.applicable_accessibilities = public

## Interfaces: IPascalCase
dotnet_naming_rule.interfaces_prefix_i.symbols = interfaces
dotnet_naming_rule.interfaces_prefix_i.style = i_pascal_case_style
dotnet_naming_rule.interfaces_prefix_i.severity = warning
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_symbols.interfaces.applicable_accessibilities = *
dotnet_naming_style.camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.capitalization = camel_case
dotnet_naming_style.underscore_camel_case_style.required_prefix = _
dotnet_naming_style.pascal_case_style.capitalization = pascal_case
dotnet_naming_style.i_pascal_case_style.capitalization = pascal_case
dotnet_naming_style.i_pascal_case_style.required_prefix = I

# GamesMayer.Diagnostics — Layout
dotnet_diagnostic.GM0001.severity = warning  # Blank line between using directives
dotnet_diagnostic.GM0002.severity = warning  # Auto-implemented property must be on a single line
dotnet_diagnostic.GM0003.severity = warning  # Attribute must be on the line immediately before the member
dotnet_diagnostic.GM0004.severity = warning  # Member declaration must be on a new line after its attributes
dotnet_diagnostic.GM0005.severity = warning  # Attributes separated by commas
dotnet_diagnostic.GM0006.severity = warning  # Blank lines between attributes
dotnet_diagnostic.GM0007.severity = warning  # Class members must be separated by a blank line
dotnet_diagnostic.GM0008.severity = warning  # Blank line within argument or parameter list
dotnet_diagnostic.GM0009.severity = warning  # No line breaks in declaration header
dotnet_diagnostic.GM0010.severity = warning  # No two consecutive blank lines
dotnet_diagnostic.GM0011.severity = warning  # No blank line at the beginning of file
dotnet_diagnostic.GM0012.severity = warning  # No blank line before opening brace
dotnet_diagnostic.GM0013.severity = warning  # Switch case block must be wrapped in braces
dotnet_diagnostic.GM0014.severity = warning  # Namespace declaration must be on a single line
dotnet_diagnostic.GM0015.severity = warning  # No blank line between control structure clauses
dotnet_diagnostic.GM0016.severity = warning  # Attribute must be on a single line
dotnet_diagnostic.GM0017.severity = warning  # Control structure clause declaration must be on a single line
dotnet_diagnostic.GM0018.severity = warning  # Switch case clause declaration must be on a single line
dotnet_diagnostic.GM0019.severity = warning  # Empty braces enclosure must be on a single line
dotnet_diagnostic.GM0020.severity = warning  # GM0020: New line required before non-empty opening brace
dotnet_diagnostic.GM0021.severity = warning  # Opening brace required on declaration line for empty enclosure (disabled by default)
dotnet_diagnostic.GM0022.severity = none     # New line required before opening brace for empty enclosure
dotnet_diagnostic.GM0023.severity = warning  # Misaligned parameter or argument in multi-line list
dotnet_diagnostic.GM0025.severity = warning  # Each argument or parameter must be on its own line in a multi-line list
dotnet_diagnostic.GM0026.severity = warning  # Closing parenthesis in multi-line list must be on a dedicated line
dotnet_diagnostic.GM0030.severity = warning  # No blank line between declaration and opening parenthesis
dotnet_diagnostic.GM0031.severity = warning  # Empty parentheses must be on the same line as the declaration
dotnet_diagnostic.GM0032.severity = warning  # Single-line parameter or argument list must be on the declaration line
dotnet_diagnostic.GM0034.severity = warning  # First item in multi-line list must start below opening parenthesis
dotnet_diagnostic.GM0035.severity = warning  # No blank lines between fluent-chain segments
dotnet_diagnostic.GM0036.severity = warning  # Variable declaration header must be on a single line
dotnet_diagnostic.GM0037.severity = warning  # Parameter declaration header must be on a single line
dotnet_diagnostic.GM0039.severity = warning  # Fluent-chain dot must be on the same line as the next identifier
dotnet_diagnostic.GM0040.severity = warning  # All fluent-chain segments must be on their own line if any segment is
dotnet_diagnostic.GM0041.severity = warning # Each segment in a multi-invocation fluent chain must be on its own line
dotnet_diagnostic.GM0041.threshold = 2
dotnet_diagnostic.GM0042.severity = warning  # Blank line required after last using directive
dotnet_diagnostic.GM0043.severity = warning #Each operand in a multi-operand logical expression must be on its own line
dotnet_diagnostic.GM0043.threshold = 3
dotnet_diagnostic.GM0044.severity = warning  # No blank line between lambda arrow and body
dotnet_diagnostic.GM0046.severity = warning  # Binary operator in multi-line expression must be at the end of the previous line
dotnet_diagnostic.GM0047.severity = warning  # Multi-line assignment value must start on the same line as the assignment operator
dotnet_diagnostic.GM0048.severity = warning  # Expression body must start on the same line as '=>'
dotnet_diagnostic.GM0050.severity = warning  # No blank lines between multi-line operator-expression items
dotnet_diagnostic.GM0051.severity = warning  # Return expression must start on the same line as 'return'
dotnet_diagnostic.GM0052.severity = warning  # No blank lines between 'return' and returned expression
dotnet_diagnostic.GM0053.severity = warning  # Each 'where' constraint clause must be on its own line
dotnet_diagnostic.GM0055.severity = warning  # No blank lines between 'where' constraint clauses
dotnet_diagnostic.GM0056.severity = warning  # 'where' constraint clause must be written on a single line
dotnet_diagnostic.GM0057.severity = warning  # No blank lines between declaration and first 'where' constraint clause
dotnet_diagnostic.GM0058.severity = warning  # Inheritance list must be on the same line as the type declaration
dotnet_diagnostic.GM0059.severity = warning  # Colon in named argument must be adjacent to parameter name
dotnet_diagnostic.GM0060.severity = warning  # Property/field access chain must be on a single line
dotnet_diagnostic.GM0061.severity = warning  # Use '==' or '!=' instead of 'is' pattern for equality comparison
dotnet_diagnostic.GM0062.severity = warning  # Use 'is or' syntax for multiple type checks on the same expression
dotnet_diagnostic.GM0063.severity = warning  # Methods and lambda expressions with braces cannot be single line statements
dotnet_diagnostic.GM0064.severity = warning  # Early return in function
dotnet_diagnostic.GM0065.severity = warning  # Return statement must be preceded by a blank line
dotnet_diagnostic.GM0066.severity = warning  # Block statement must be preceded by blank line
dotnet_diagnostic.GM0067.severity = warning  # Block statement must be followed by a blank line
dotnet_diagnostic.GM0068.severity = warning  # Multiple statements on one line
dotnet_diagnostic.GM0069.severity = warning  # Properties not autoimplemented cannot be single line statements
dotnet_diagnostic.GM0070.severity = warning  # Each accessor must be on its own line in non-autoimplemented properties
dotnet_diagnostic.GM0071.severity = warning  # Each accessor in non-autoimplemented properties must be separated by a blank line
dotnet_diagnostic.GM0072.severity = warning  # Blank line required before #if directive
dotnet_diagnostic.GM0073.severity = warning  # Blank line required after #endif directive
dotnet_diagnostic.GM0074.severity = warning  # #if / #else / #elif directive must not be followed by blank line
dotnet_diagnostic.GM0075.severity = warning  # #endif / #else / #elif directive must not be preceded by blank line
dotnet_diagnostic.GM0080.severity = warning  # Break statement must be preceded by a blank line
dotnet_diagnostic.GM1505.severity = warning  # Opening brace must not be followed by blank line
dotnet_diagnostic.GM1508.severity = warning  # Closing brace must not be preceded by blank line
dotnet_diagnostic.GM0112.severity = warning  # No blank lines between consecutive variables

# GamesMayer.Diagnostics — Indentation (GM0024, GM0027-GM0029, GM0033, GM0038, GM0045, GM0049, GM0054, GM0077-GM0078, GM0081)
dotnet_diagnostic.GM0024.severity = warning  # Anonymous function incorrectly indented
dotnet_diagnostic.GM0027.severity = none     # Parenthesis K&R indentation style in multi-line list (disabled by default)
dotnet_diagnostic.GM0028.severity = warning  # Closing parenthesis indentation in multi-line list
dotnet_diagnostic.GM0029.severity = warning  # Parenthesis Allman indentation style in multi-line list
dotnet_diagnostic.GM0033.severity = warning  # Opening parenthesis indentation in multi-line argument/parameter list
dotnet_diagnostic.GM0038.severity = warning  # Fluent-chain segment indentation
dotnet_diagnostic.GM0045.severity = warning  # Lambda expression body must be indented one step from the arrow line
dotnet_diagnostic.GM0049.severity = warning  # Wrapped operator-expression item must be indented one step from expression start line
dotnet_diagnostic.GM0054.severity = warning  # 'where' constraint clause must be indented one step from the declaration
dotnet_diagnostic.GM0077.severity = warning  # Block contents must be indented one step from the block braces
dotnet_diagnostic.GM0078.severity = warning  # Block brace must be indented at the declaration level
dotnet_diagnostic.GM0081.severity = warning  # Case labels must be indented one step right from the switch keyword

# GamesMayer.Diagnostics — Spacing
dotnet_diagnostic.GM0079.severity = warning  # No more than one space between tokens
dotnet_diagnostic.GM0082.severity = warning  # Cast expression spacing
dotnet_diagnostic.GM0082.enabled = false
dotnet_diagnostic.GM0083.severity = warning  # Space after control-flow keywords
dotnet_diagnostic.GM0083.enabled = true
dotnet_diagnostic.GM0084.severity = warning  # Spaces inside method declaration parameter list parentheses
dotnet_diagnostic.GM0084.enabled = false
dotnet_diagnostic.GM0085.severity = warning  # Spaces inside method call argument list parentheses
dotnet_diagnostic.GM0085.enabled = false
dotnet_diagnostic.GM0086.severity = warning  # Space before colon in inheritance clause
dotnet_diagnostic.GM0086.enabled = true
dotnet_diagnostic.GM0087.severity = warning  # Space after colon in inheritance clause
dotnet_diagnostic.GM0087.enabled = true
dotnet_diagnostic.GM0088.severity = warning  # Space around binary operators
dotnet_diagnostic.GM0088.enabled = true
dotnet_diagnostic.GM0089.severity = warning  # Space between parentheses
dotnet_diagnostic.GM0089.enabled = false
dotnet_diagnostic.GM0090.severity = warning  # Space in empty method declaration parameter list
dotnet_diagnostic.GM0090.enabled = false
dotnet_diagnostic.GM0091.severity = warning  # Space between method declaration name and open parenthesis
dotnet_diagnostic.GM0091.enabled = false
dotnet_diagnostic.GM0092.severity = warning  # Space in empty method call argument list
dotnet_diagnostic.GM0092.enabled = false
dotnet_diagnostic.GM0093.severity = warning  # Space between method call name and opening parenthesis
dotnet_diagnostic.GM0093.enabled = false
dotnet_diagnostic.GM0094.severity = warning  # Space after comma
dotnet_diagnostic.GM0094.enabled = true
dotnet_diagnostic.GM0095.severity = warning  # Space before comma
dotnet_diagnostic.GM0095.enabled = false
dotnet_diagnostic.GM0096.severity = warning  # Space after dot
dotnet_diagnostic.GM0096.enabled = false
dotnet_diagnostic.GM0097.severity = warning  # Space before dot
dotnet_diagnostic.GM0097.enabled = false
dotnet_diagnostic.GM0099.severity = warning  # Space after semicolon in for statement
dotnet_diagnostic.GM0099.enabled = true
dotnet_diagnostic.GM0100.severity = warning  # Space before semicolon in for statement
dotnet_diagnostic.GM0100.enabled = false
dotnet_diagnostic.GM0098.severity = warning  # Space before open square bracket
dotnet_diagnostic.GM0098.enabled = false
dotnet_diagnostic.GM0101.severity = warning  # Space between empty square brackets
dotnet_diagnostic.GM0101.enabled = false
dotnet_diagnostic.GM0102.severity = warning  # Space between square brackets
dotnet_diagnostic.GM0102.enabled = false
dotnet_diagnostic.GM0103.severity = warning  # Space before generic '<' symbol
dotnet_diagnostic.GM0103.enabled = false
dotnet_diagnostic.GM0104.severity = warning  # Space between generic operators '<' and '>'
dotnet_diagnostic.GM0104.enabled = false
dotnet_diagnostic.GM0105.severity = warning  # Space around ternary operators '?' and ':'
dotnet_diagnostic.GM0105.enabled = true
dotnet_diagnostic.GM0106.severity = warning  # Space before => symbol
dotnet_diagnostic.GM0106.enabled = true
dotnet_diagnostic.GM0107.severity = warning  # Space after => symbol
dotnet_diagnostic.GM0107.enabled = true
dotnet_diagnostic.GM0108.severity = warning  # Space after type in declarations
dotnet_diagnostic.GM0108.enabled = true
dotnet_diagnostic.GM0109.severity = warning  # Space before assignment operator '='
dotnet_diagnostic.GM0109.enabled = true
dotnet_diagnostic.GM0110.severity = warning  # Space after assignment operator '='
dotnet_diagnostic.GM0110.enabled = true
dotnet_diagnostic.GM0111.severity = warning  # Statement closing semicolon must be adjacent to previous token
dotnet_diagnostic.GM0113.severity = warning  # Space between single-line block braces
dotnet_diagnostic.GM0113.enabled = true

# GamesMayer.Diagnostics — Architecture (GM0076)
dotnet_diagnostic.GM0076.severity = warning  # Avoid using Unity Debug.Log methods directly

# GamesMayer.Diagnostics — Ordering (GM1200-GM1216)
dotnet_diagnostic.GM1200.severity = warning  # A C# using directive is placed inside a namespace element
dotnet_diagnostic.GM1201.severity = warning  # Elements must appear in the correct order
dotnet_diagnostic.GM1202.severity = warning  # Elements must be ordered by access
dotnet_diagnostic.GM1203.severity = warning  # Constants must appear before fields
dotnet_diagnostic.GM1204.severity = warning  # Static elements must appear before instance elements
dotnet_diagnostic.GM1205.severity = warning  # Partial element does not have an access modifier defined
dotnet_diagnostic.GM1206.severity = warning  # Declaration keywords must follow order
dotnet_diagnostic.GM1207.severity = warning  # The keyword 'protected' must come before 'internal'
dotnet_diagnostic.GM1208.severity = warning  # System using directives must be placed before other using directives
dotnet_diagnostic.GM1209.severity = warning  # Using alias directives must be placed after other using directives
dotnet_diagnostic.GM1210.severity = warning  # Using directives must be ordered alphabetically by the namespaces
dotnet_diagnostic.GM1211.severity = warning  # Using alias directives must be ordered alphabetically by alias name
dotnet_diagnostic.GM1212.severity = warning  # A get accessor appears after a set accessor within a property or indexer
dotnet_diagnostic.GM1213.severity = warning  # An add accessor appears after a remove accessor within an event
dotnet_diagnostic.GM1214.severity = warning  # Readonly elements must appear before non-readonly elements
dotnet_diagnostic.GM1215.severity = warning  # Using static directives must be ordered alphabetically
dotnet_diagnostic.GM1216.severity = warning  # Using static directives must be placed at the correct location

# GamesMayer.Diagnostics — Naming (GM1300)
dotnet_diagnostic.GM1300.severity = warning  # Element must begin with an upper-case letter
